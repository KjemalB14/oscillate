#!/usr/bin/env python3
# purpose: Record memory and CPU of the running Oscillate app, its WebKit helpers and PTY children.
"""Samples the running Oscillate app and prints one row per process plus a total.

Processes counted:
  app       the Tauri binary (found by --pid, or pgrep for target/*/oscillate or Oscillate.app)
  webkit    WebKit GPU/Networking/WebContent helpers started after the app with the same
            responsible pid (they are launchd children, so this is how they're tied back)
  pty       every descendant of the app: shells, `claude attach`, whatever runs in them

Memory is phys_footprint (what Activity Monitor calls Memory) from /usr/bin/footprint.
CPU is the average % over the sample window, from cumulative CPU time.
"""
import argparse, ctypes, re, subprocess, sys, time

WEBKIT = "/System/Library/Frameworks/WebKit.framework/Versions/A/XPCServices/"


def fail(msg):
    sys.exit(f"measure-footprint: {msg}")


def ps_table():
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,etime=,time=,comm="],
                         capture_output=True, text=True, check=True).stdout
    rows = {}
    for line in out.splitlines():
        pid, ppid, etime, cpu, comm = line.split(None, 4)
        rows[int(pid)] = dict(ppid=int(ppid), age=seconds(etime), cpu=seconds(cpu), comm=comm)
    return rows


def seconds(t):
    """ps elapsed/cpu time, [[dd-]hh:]mm:ss[.cc] -> seconds."""
    days, _, t = t.rpartition("-")
    parts = [float(x) for x in t.split(":")]
    s = sum(v * 60 ** i for i, v in enumerate(reversed(parts)))
    return s + (int(days) * 86400 if days else 0)


def responsible(pid):
    f = ctypes.CDLL(None).responsibility_get_pid_responsible_for_pid
    f.restype, f.argtypes = ctypes.c_int, [ctypes.c_int]
    return f(pid)


def phys_footprint(pid):
    out = subprocess.run(["footprint", "-p", str(pid), "-f", "bytes"],
                         capture_output=True, text=True).stdout
    m = re.search(r"phys_footprint: (\d+) B", out)
    return int(m.group(1)) if m else None


def find_app():
    out = subprocess.run(["pgrep", "-f", r"target/(debug|release)/oscillate$|Oscillate\.app/Contents/MacOS/"],
                         capture_output=True, text=True).stdout.split()
    if len(out) != 1:
        fail(f"expected one running Oscillate, found {len(out)}; pass --pid")
    return int(out[0])


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--pid", type=int, help="app pid (default: find it)")
    p.add_argument("--window", type=float, default=10, help="CPU sample window in seconds (default 10)")
    p.add_argument("--label", default="", help="prefix for the total line, e.g. 'idle shell'")
    a = p.parse_args()

    app = a.pid or find_app()
    rows = ps_table()
    if app not in rows:
        fail(f"no process {app}")
    resp = responsible(app)
    procs = {app: "app"}
    for pid, r in rows.items():
        if r["comm"].startswith(WEBKIT) and r["age"] <= rows[app]["age"] and responsible(pid) == resp:
            procs[pid] = "webkit"
    frontier = [app]
    while frontier:
        parent = frontier.pop()
        for pid, r in rows.items():
            if r["ppid"] == parent and pid not in procs:
                procs[pid] = "pty"
                frontier.append(pid)

    time.sleep(a.window)
    after = ps_table()
    total_mem, total_cpu = 0, 0.0
    print(f"{'pid':>7} {'kind':6} {'MiB':>8} {'CPU%':>6}  command")
    for pid, kind in procs.items():
        if pid not in after:
            continue
        mem = phys_footprint(pid) or 0
        cpu = 100 * (after[pid]["cpu"] - rows[pid]["cpu"]) / a.window
        total_mem += mem
        total_cpu += cpu
        print(f"{pid:>7} {kind:6} {mem / 2**20:8.1f} {cpu:6.1f}  {after[pid]['comm'].rsplit('/', 1)[-1]}")
    print(f"{a.label + ': ' if a.label else ''}total {total_mem / 2**20:.1f} MiB, "
          f"{total_cpu:.1f}% CPU over {a.window:g}s, {len(procs)} processes")


if __name__ == "__main__":
    main()
