{
  "name": "oscillate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "e2e:build": "sh e2e/build.sh",
    "e2e": "sh e2e/build.sh && wdio run e2e/wdio.conf.ts",
    "e2e:check": "sh e2e/build.sh && wdio run e2e/wdio.conf.ts --spec e2e/harness.check.ts",
    "e2e:snapshot": "sh e2e/build.sh && wdio run e2e/wdio.conf.ts --spec e2e/snapshot.check.ts",
    "theme:check": ".claude/scripts/check-theme"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-unicode-graphemes": "0.5.0-beta.301",
    "@xterm/addon-web-links": "0.13.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.304",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "webdriverio": "^9.32.0"
  }
}
